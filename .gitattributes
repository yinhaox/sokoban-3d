# Normalize text files to LF so Godot, Python and the studio scripts behave the
# same on Windows, macOS and Linux.
* text=auto
*.md text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
